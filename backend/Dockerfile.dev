FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1

WORKDIR /app

# Install OS packages commonly needed for Python packages and Postgres client build
RUN apt-get update \
	&& apt-get install -y --no-install-recommends gcc libpq-dev build-essential \
	&& rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && \
	if [ -s /app/requirements.txt ]; then pip install --no-cache-dir -r /app/requirements.txt; fi

# Copy application code
COPY . /app

EXPOSE 8000

# Default command - override in production if needed. Assumes an ASGI app is exposed as `main:app`.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]


